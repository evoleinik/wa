#!/usr/bin/env python3
"""wa - WhatsApp CLI over the WhatsApp for Mac database: reads, and sends one message on --yes.

On the Mac it reads the database in place. From another machine, set WA_HOST to
the Mac's SSH host: wa sends itself over SSH and the query runs there, so the
database stays on the Mac and only printed rows cross SSH. It never writes the
database: it opens it with mode=ro and PRAGMA query_only.

Over SSH, macOS only lets wa in when sshd has Full Disk Access, and that grant covers
every SSH login. Set WA_LAUNCHER to the path of launcher/wa-launch on the Mac instead:
wa then runs that small signed program over SSH, and only it holds the grant.

`wa media <id>` is the one command that writes, and only a copy of one media file,
into ~/.cache/wa/media or the -o path, on the machine running wa.

`wa send` sends one message through WhatsApp for Mac, only with --yes. It opens
whatsapp://send, checks the composer holds the text, presses Send through
Accessibility, and reads the message back from the database.

Exit codes: 0 ok (empty results print a hint to stderr), 1 WhatsApp changed its
database schema or its window, 2 bad arguments or no single chat matched, 3 cannot
reach the host or read the database, 4 a bug in wa, 5 sent but not confirmed.

Python 3.9 compatible, because macOS ships /usr/bin/python3 3.9.
https://github.com/evoleinik/wa
"""
import argparse
import base64
import json
import os
import re
import shlex
import shutil
import sqlite3
import subprocess
import sys
import time
import urllib.parse
from datetime import datetime

DEFAULT_DB = os.path.expanduser(
    "~/Library/Group Containers/group.net.whatsapp.WhatsApp.shared/ChatStorage.sqlite")
VERSION = "2026.11.24.4"
HOST = os.environ.get("WA_HOST")  # SSH host of the Mac; unset means read locally
# Path of wa-launch on the Mac. wa-launch also sets it for the wa it runs, so hints name it.
LAUNCHER = os.environ.get("WA_LAUNCHER")
LAUNCHED = os.environ.get("WA_LAUNCHED") == "1"  # set by wa-launch, which holds the grant
USAGE_LOG = os.path.expanduser("~/.wa/usage.jsonl")
MEDIA_CACHE = "~/.cache/wa/media"  # expanded at use, so HOME can change in tests
MEDIA_DIR = "Message"  # media paths in the database are relative to this folder
EPOCH = 978307200  # Core Data dates count seconds from 2001-01-01 UTC.
FDA_FIX = ("on the Mac, System Settings > Privacy & Security > Full Disk Access: add your "
           "terminal app, or set WA_LAUNCHER and add wa-launch when reading over SSH "
           "(see launcher/install.sh)")
if LAUNCHER:
    FDA_FIX = ("on the Mac, System Settings > Privacy & Security > Full Disk Access: add %s"
               % LAUNCHER)
ISSUES = "https://github.com/evoleinik/wa/issues"

# Every column the queries read. A WhatsApp update that drops one reds every command.
REQUIRED = {
    "ZWAMESSAGE": ["Z_PK", "ZCHATSESSION", "ZGROUPMEMBER", "ZMEDIAITEM", "ZISFROMME",
                   "ZMESSAGETYPE", "ZMESSAGEDATE", "ZTEXT"],
    "ZWACHATSESSION": ["Z_PK", "ZCONTACTJID", "ZPARTNERNAME", "ZSESSIONTYPE",
                       "ZLASTMESSAGEDATE", "ZLASTMESSAGE", "ZUNREADCOUNT",
                       "ZARCHIVED", "ZHIDDEN", "ZREMOVED"],
    "ZWAGROUPMEMBER": ["Z_PK", "ZMEMBERJID", "ZCONTACTNAME", "ZFIRSTNAME"],
    "ZWAPROFILEPUSHNAME": ["ZJID", "ZPUSHNAME"],
    "ZWAMEDIAITEM": ["Z_PK", "ZTITLE", "ZMEDIALOCALPATH", "ZXMPPTHUMBPATH"],
}
# Session types: 0 direct, 1 group, 4 community group. 2 broadcast and 3 status are skipped.
CHAT_FILTER = ("s.ZSESSIONTYPE IN (0,1,4) AND coalesce(s.ZHIDDEN,0)=0 "
               "AND coalesce(s.ZREMOVED,0)=0")
LABELS = {1: "image", 2: "video", 3: "voice", 4: "contact", 5: "location", 8: "document",
          11: "gif", 14: "deleted", 15: "sticker", 23: "video", 27: "invite", 46: "poll"}
SYSTEM = (6, 10, 13)
PLAIN = (0, 7)  # text and link messages
VISIBLE = ("(m.ZMESSAGETYPE IN (%s) OR (m.ZMESSAGETYPE NOT IN (%s) AND m.ZTEXT IS NOT NULL))"
           % (",".join(str(t) for t in PLAIN + tuple(LABELS)), ",".join(str(t) for t in SYSTEM)))

MSG_SQL = """
SELECT m.ZMESSAGEDATE, m.ZISFROMME, m.ZMESSAGETYPE, m.ZTEXT, mi.ZTITLE,
       s.ZPARTNERNAME, s.ZCONTACTJID, s.ZSESSIONTYPE,
       gm.ZCONTACTNAME, gm.ZFIRSTNAME,
       (SELECT p.ZPUSHNAME FROM ZWAPROFILEPUSHNAME p WHERE p.ZJID = gm.ZMEMBERJID LIMIT 1),
       gm.ZMEMBERJID, m.Z_PK, mi.ZMEDIALOCALPATH, mi.ZXMPPTHUMBPATH
FROM ZWAMESSAGE m
JOIN ZWACHATSESSION s ON s.Z_PK = m.ZCHATSESSION
LEFT JOIN ZWAMEDIAITEM mi ON mi.Z_PK = m.ZMEDIAITEM
LEFT JOIN ZWAGROUPMEMBER gm ON gm.Z_PK = m.ZGROUPMEMBER
WHERE {where}
ORDER BY m.ZMESSAGEDATE DESC
LIMIT ?
"""


MEDIA_BASE = None  # set by connect(): the folder media paths are relative to


class Fail(Exception):
    def __init__(self, code, msg, hint=None):
        Exception.__init__(self, msg)
        self.code, self.msg, self.hint = code, msg, hint


def since_arg(s):
    if re.fullmatch(r"\d+[mhdw]", s):
        return s
    try:
        datetime.strptime(s, "%Y-%m-%d")
        return s
    except ValueError:
        raise argparse.ArgumentTypeError("use 30m, 24h, 7d, 2w or a real date like 2026-10-01")


def positive_int(s):
    if s.isdigit() and int(s) > 0:
        return int(s)
    raise argparse.ArgumentTypeError("must be a whole number above 0")


CONTROL = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def clean(text):
    """Drop control characters, so a message cannot send escape codes to the terminal."""
    return CONTROL.sub("", text or "")


def since_value(s):
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", s):
        return datetime.strptime(s, "%Y-%m-%d").timestamp() - EPOCH
    unit = {"m": 60, "h": 3600, "d": 86400, "w": 604800}[s[-1]]
    return time.time() - int(s[:-1]) * unit - EPOCH


def short_time(ts):
    if ts is None:
        return "----------------"
    return datetime.fromtimestamp(ts + EPOCH).strftime("%Y-%m-%d %H:%M")


def iso_time(ts):
    if ts is None:
        return None
    return datetime.fromtimestamp(ts + EPOCH).astimezone().isoformat(timespec="seconds")


def user_part(jid):
    return jid.split("@")[0] if jid else None


def one_line(text, limit=None):
    text = clean((text or "").replace("\r", "").replace("\n", " ⏎ ")).strip()
    if limit and len(text) > limit:
        return text[:limit] + "…"
    return text


def connect(path):
    """Open read-only. Raises Fail(3) when the file cannot be read, Fail(1) on schema drift."""
    folder = os.path.dirname(path)
    try:
        os.listdir(folder)
    except PermissionError:
        raise Fail(3, "macOS denied access to %s" % folder, FDA_FIX)
    except FileNotFoundError:
        raise Fail(3, "no WhatsApp data at %s" % folder, "install and sign in to WhatsApp for Mac")
    if not os.path.exists(path):
        raise Fail(3, "database missing: %s" % path, "open WhatsApp for Mac once, then retry")
    # WhatsApp keeps the DB in WAL mode. While it runs, the -shm index exists and a normal
    # read-only open shares it. After it quits, -shm is gone: a read-only open then fails
    # (macOS SQLite) or creates -shm in WhatsApp's folder (newer SQLite). immutable=1 reads
    # the main file with no index, no locks and no new files.
    uri = "file:%s?mode=ro" % urllib.parse.quote(path)
    if not os.path.exists(path + "-shm"):
        uri += "&immutable=1"
        wal = path + "-wal"
        if os.path.exists(wal) and os.path.getsize(wal) > 0:
            print("wa: WhatsApp is not running and left unsaved changes; "
                  "the newest messages may be missing. Open WhatsApp to fix.", file=sys.stderr)
    try:
        db = sqlite3.connect(uri, uri=True, timeout=5)
        db.execute("PRAGMA query_only=1")
        # One message with broken UTF-8 must not stop a whole listing.
        db.text_factory = lambda b: b.decode("utf-8", "replace")
        missing = []
        for table, cols in REQUIRED.items():
            have = {r[1] for r in db.execute("PRAGMA table_info(%s)" % table)}
            missing += ["%s.%s" % (table, c) for c in cols if c not in have]
    except sqlite3.Error as e:
        raise Fail(3, "cannot read %s: %s" % (path, e), "wa status, then open WhatsApp for Mac")
    if missing:
        raise Fail(1, "WhatsApp changed its database schema. Missing: %s" % ", ".join(missing),
                   "upgrade wa, or report it at " + ISSUES)
    db.create_function("wa_match", 2, match_terms, deterministic=True)
    global MEDIA_BASE
    MEDIA_BASE = os.path.join(os.path.dirname(path), MEDIA_DIR)
    return db


def media_file(rel):
    """Absolute path of a media file inside MEDIA_BASE, or None when absent or outside it."""
    if not rel:
        return None
    base = os.path.realpath(MEDIA_BASE)
    full = os.path.realpath(os.path.join(base, rel))
    if not full.startswith(base + os.sep) or not os.path.isfile(full):
        return None
    return full


def media_state(full_rel, thumb_rel):
    if media_file(full_rel):
        return "full"
    return "preview" if media_file(thumb_rel) else "missing"


def match_terms(text, query):
    """Every whitespace-separated term must appear, case-insensitive, any script."""
    hay = (text or "").casefold()
    return all(t in hay for t in query.casefold().split())


def to_message(row):
    date, me, typ, text, title, chat, jid, stype, gname, gfirst, push, mjid = row[:12]
    pk, full_rel, thumb_rel = row[12:]
    if me:
        sender = "me"
    elif stype == 0:
        sender = chat or user_part(jid)
    else:
        sender = gname or gfirst or push or user_part(mjid) or "?"
    body = "" if typ == 14 else (text or title or "").strip()
    if typ in PLAIN:
        kind = "text"
    elif typ in SYSTEM:
        kind = "system"
    else:
        kind = LABELS.get(typ, "type %d" % typ)
    media = None
    if kind not in ("text", "system", "deleted") and (full_rel or thumb_rel):
        media = media_state(full_rel, thumb_rel)
    return {"id": pk, "time": iso_time(date), "ts": date, "chat": chat or user_part(jid),
            "from": sender, "me": bool(me), "type": kind, "text": body, "media": media}


def shown(msg):
    if msg["type"] == "text":
        return msg["text"]
    tag = msg["type"] + (" #%d" % msg["id"] if msg.get("media") else "")
    return ("[%s] %s" % (tag, msg["text"])).strip()


def query_messages(db, where, params, limit, show_all):
    clauses = [CHAT_FILTER] + where + ([] if show_all else [VISIBLE])
    sql = MSG_SQL.format(where=" AND ".join(clauses))
    return [to_message(r) for r in db.execute(sql, params + [limit])]


def resolve_chat(db, q):
    rows = db.execute("SELECT s.Z_PK, s.ZPARTNERNAME, s.ZCONTACTJID FROM ZWACHATSESSION s WHERE "
                      + CHAT_FILTER + " ORDER BY s.ZLASTMESSAGEDATE DESC").fetchall()
    hits = [r for r in rows if r[2] == q]  # an exact JID wins
    if not hits:
        folded = q.casefold()
        # Phone digits match a person's number, never a group id or digits in a name.
        digits = re.sub(r"\D", "", q) if re.fullmatch(r"[\d\s()+.-]+", q) else ""
        hits = [r for r in rows if folded in (r[1] or "").casefold()
                or (len(digits) >= 5 and not (r[2] or "").endswith("@g.us")
                    and digits in (user_part(r[2]) or ""))]
        exact = [r for r in hits if (r[1] or "").casefold() == folded]
        if len(exact) == 1:
            hits = exact
    if not hits:
        raise Fail(2, "no chat matches %r (searched %d chats)" % (q, len(rows)),
                   "wa chats -n 100")
    if len(hits) > 1:
        lines = "\n".join("  %s    # %s" % (shlex.join(["wa", "read", r[2]]), clean(r[1]))
                          for r in hits[:10])
        more = "" if len(hits) <= 10 else "\n  ... and %d more" % (len(hits) - 10)
        raise Fail(2, "%d chats match %r. Re-run with one JID:\n%s%s" % (len(hits), q, lines, more))
    return hits[0]


def cmd_chats(db, a):
    # ZLASTMESSAGETEXT holds encoded bytes, so the preview comes from the last message row.
    # Pinned chats carry a ZLASTMESSAGEDATE ~7000 years ahead, so order and show by the
    # real last message time and flag the pin.
    sql = ("SELECT s.ZPARTNERNAME, s.ZCONTACTJID, s.ZSESSIONTYPE, "
           "coalesce(lm.ZMESSAGEDATE, CASE WHEN s.ZLASTMESSAGEDATE > ? THEN NULL "
           "ELSE s.ZLASTMESSAGEDATE END) AS last, s.ZUNREADCOUNT, "
           "lm.ZMESSAGETYPE, coalesce(lm.ZTEXT, lmi.ZTITLE), s.ZARCHIVED, "
           "s.ZLASTMESSAGEDATE > ? AS pinned FROM ZWACHATSESSION s "
           "LEFT JOIN ZWAMESSAGE lm ON lm.Z_PK = s.ZLASTMESSAGE "
           "LEFT JOIN ZWAMEDIAITEM lmi ON lmi.Z_PK = lm.ZMEDIAITEM WHERE "
           + CHAT_FILTER + " AND s.ZLASTMESSAGEDATE IS NOT NULL"
           + (" AND coalesce(s.ZUNREADCOUNT,0) != 0" if a.unread else "")
           + " ORDER BY last DESC LIMIT ?")
    out = []
    a_year_ahead = time.time() - EPOCH + 365 * 86400
    for name, jid, stype, last, unread, ltype, ltext, archived, pinned in db.execute(
            sql, [a_year_ahead, a_year_ahead, a.n]):
        if ltype is None or ltype in PLAIN:
            preview = ltext
        elif ltype in SYSTEM:
            preview = "[system]"  # its text is a JSON event payload
        else:
            preview = ("[%s] %s" % (LABELS.get(ltype, "type %d" % ltype),
                                    "" if ltype == 14 else (ltext or ""))).strip()
        out.append({"name": name or user_part(jid), "jid": jid,
                    "kind": "dm" if stype == 0 else "group", "last": iso_time(last),
                    "unread": unread or 0, "archived": bool(archived), "pinned": bool(pinned),
                    "preview": one_line(preview, 80), "ts": last})
    if not out:
        hint("No%s chats found." % (" unread" if a.unread else ""),
             "wa chats" if a.unread else "open WhatsApp for Mac so it syncs")
    return out, lambda c: "%s  %s%s: %s" % (
        short_time(c["ts"]), clean(c["name"]),
        "".join(" [%s]" % t for t in (
            "group" if c["kind"] == "group" else "",
            "%s unread" % c["unread"] if c["unread"] else "",
            "pinned" if c["pinned"] else "",
            "archived" if c["archived"] else "") if t),
        c["preview"])


def cmd_read(db, a):
    pk, name, jid = resolve_chat(db, a.chat)
    where, params = ["s.Z_PK = ?"], [pk]
    if a.since:
        where.append("m.ZMESSAGEDATE >= ?")
        params.append(since_value(a.since))
    msgs = query_messages(db, where, params, a.n, a.all)[::-1]
    if not msgs:
        hint("No messages in %s (%s)%s." % (clean(name), jid, " since " + a.since if a.since else ""),
             "drop --since, or add --all for system events")
    return msgs, lambda m: "%s %s: %s" % (short_time(m["ts"]), clean(m["from"]),
                                          one_line(shown(m)))


def cmd_search(db, a):
    query = " ".join(a.query)
    where, params, scope = ["wa_match(coalesce(m.ZTEXT,'') || ' ' || coalesce(mi.ZTITLE,''), ?)"], [query], []
    if a.chat:
        pk, name, _ = resolve_chat(db, a.chat)
        where.append("s.Z_PK = ?")
        params.append(pk)
        scope.append("chat " + name)
    if a.since:
        where.append("m.ZMESSAGEDATE >= ?")
        params.append(since_value(a.since))
        scope.append("since " + a.since)
    msgs = query_messages(db, where, params, a.n, a.all)
    if not msgs:
        tries = (["drop --chat"] if a.chat else []) + (["drop --since"] if a.since else []) \
            + (["fewer words"] if len(query.split()) > 1 else []) + ["a shorter word stem"]
        hint("Searched all messages (%s) for every word of %r." % (", ".join(scope) or "all chats, all time", query),
             ", ".join(tries))
    return msgs, lambda m: "%s [%s] %s: %s" % (short_time(m["ts"]), clean(m["chat"]),
                                              clean(m["from"]), one_line(shown(m), 200))


def cmd_recent(db, a):
    where, params = ["m.ZMESSAGEDATE >= ?"], [since_value(a.since)]
    if a.chat:
        pk, _, _ = resolve_chat(db, a.chat)
        where.append("s.Z_PK = ?")
        params.append(pk)
    msgs = query_messages(db, where, params, a.n, a.all)[::-1]
    if not msgs:
        hint("No messages in the last %s%s." % (a.since, " in that chat" if a.chat else ""),
             "--since 7d")
    return msgs, lambda m: "%s [%s] %s: %s" % (short_time(m["ts"]), clean(m["chat"]),
                                              clean(m["from"]), one_line(shown(m), 200))


def media_row(db, mid):
    row = db.execute(
        "SELECT m.ZMESSAGETYPE, mi.ZMEDIALOCALPATH, mi.ZXMPPTHUMBPATH, m.ZMESSAGEDATE, "
        "s.ZPARTNERNAME, s.ZCONTACTJID FROM ZWAMESSAGE m "
        "JOIN ZWACHATSESSION s ON s.Z_PK = m.ZCHATSESSION "
        "LEFT JOIN ZWAMEDIAITEM mi ON mi.Z_PK = m.ZMEDIAITEM "
        "WHERE m.Z_PK = ? AND " + CHAT_FILTER, [mid]).fetchone()
    if not row:
        raise Fail(2, "no message with id %d" % mid, "take ids from wa read --json")
    typ, full_rel, thumb_rel, date, chat, jid = row
    if not (full_rel or thumb_rel):
        raise Fail(2, "message %d has no media" % mid, "take ids from [image #id] lines")
    src = media_file(full_rel)
    kind = "full"
    if not src:
        src, kind = media_file(thumb_rel), "preview"
    if not src:
        raise Fail(3, "the file for message %d is not on the Mac" % mid,
                   "open that chat in WhatsApp for Mac to download it, then rerun")
    ext = os.path.splitext(full_rel or "")[1] if kind == "full" else ".jpg"
    name = "%d%s%s" % (mid, "" if kind == "full" else ".preview", ext)
    label = "system" if typ in SYSTEM else LABELS.get(typ, "type %d" % typ)
    return src, {"id": mid, "media": kind, "type": label, "name": name,
                 "chat": clean(chat or user_part(jid)), "time": iso_time(date)}


def save_media(info, write, dest):
    """Write one media file to dest (a folder or a file path) and return its info."""
    target = os.path.expanduser(dest or MEDIA_CACHE)
    if dest is None or os.path.isdir(target) or dest.endswith(os.sep):
        target = os.path.join(target, info["name"])
    os.makedirs(os.path.dirname(os.path.abspath(target)), exist_ok=True)
    write(target)
    info = dict(info, path=os.path.abspath(target), bytes=os.path.getsize(target))
    if info["media"] == "preview":
        print("wa: only a small preview of this file is on the Mac. Open the chat in WhatsApp "
              "for Mac to download the full file, then rerun.", file=sys.stderr)
    return info


def cmd_media(db, a):
    src, info = media_row(db, a.id)
    if a.b64:  # used over SSH: the caller writes the file on its own machine
        with open(src, "rb") as f:
            info = dict(info, data=base64.b64encode(f.read()).decode("ascii"))
        return info, None
    info = save_media(info, lambda t: shutil.copyfile(src, t), a.o)
    return info, lambda i: i["path"]


def cmd_status(db, a):
    msgs, chats, last = db.execute(
        "SELECT (SELECT count(*) FROM ZWAMESSAGE), (SELECT count(*) FROM ZWACHATSESSION s WHERE "
        + CHAT_FILTER + "), (SELECT max(ZMESSAGEDATE) FROM ZWAMESSAGE)").fetchone()
    path = os.environ.get("WA_DB", DEFAULT_DB)
    out = {"db": path, "size_mb": round(os.path.getsize(path) / 1e6, 1), "messages": msgs,
           "chats": chats, "latest": iso_time(last) if last else None, "schema_ok": True,
           "send_ready": sys.platform == "darwin" and AX().trusted()}
    if not out["send_ready"]:
        print("wa: send is off: macOS has not given wa Accessibility.", file=sys.stderr)
        print("Try: " + AX_FIX, file=sys.stderr)
    return out, lambda o: "ok: %s messages, %s chats, latest %s, %s MB, send %s" % (
        o["messages"], o["chats"], o["latest"], o["size_mb"],
        "ready" if o["send_ready"] else "off")


# --- send -----------------------------------------------------------------------------
# wa sends through WhatsApp for Mac itself: it opens whatsapp://send, checks the composer
# holds exactly the text, presses the Send button through Accessibility, then reads the
# message back from the database. No second device, no unofficial client.

SEND_GAP = 60  # seconds between two sends, so wa never sends from a loop
SEND_STAMP = "~/.wa/last-send"  # on the machine that runs wa, never under wa-launch
UI_WAIT = 15  # seconds to wait for the chat to open
READBACK_WAIT = 20  # seconds to wait for the sent message to reach the database
SETTLE_WAIT = 3  # seconds after each press before wa tries the next way
AX_FIX = ("on the Mac, System Settings > Privacy & Security > Accessibility: add %s"
          % (LAUNCHER or "your terminal app"))


def norm(text):
    return " ".join((text or "").split())


def phone_digits(s):
    """Digits of a phone number with country code, or None when s is not a phone number."""
    if not re.fullmatch(r"\+?[\d\s().-]+", s):
        return None
    digits = re.sub(r"\D", "", s)
    if s.lstrip().startswith("0") or not 8 <= len(digits) <= 15:
        raise Fail(2, "%r is not a full phone number" % s,
                   "write it with the country code, like +62 852 8382 6458")
    return digits


def send_target(db, to):
    """Resolve <to> to {phone, jid, name, new_chat}. Only direct chats with a phone JID."""
    digits = phone_digits(to)
    if digits:
        jid = digits + "@s.whatsapp.net"
        row = db.execute("SELECT s.ZPARTNERNAME FROM ZWACHATSESSION s WHERE s.ZCONTACTJID = ? "
                         "AND " + CHAT_FILTER, [jid]).fetchone()
        return {"phone": "+" + digits, "jid": jid, "name": clean(row[0]) if row else None,
                "new_chat": row is None}
    _, name, jid = resolve_chat(db, to)
    if not (jid or "").endswith("@s.whatsapp.net"):
        raise Fail(2, "%s (%s) is not a direct chat with a phone number" % (clean(name), clean(jid)),
                   "wa send sends to one person: pass their number, like +62 852 8382 6458")
    return {"phone": "+" + user_part(jid), "jid": jid, "name": clean(name), "new_chat": False}


def send_text(a):
    if a.text_file is not None and LAUNCHED:
        # The granted process could read any file and print it in the preview.
        raise Fail(2, "under wa-launch, wa send takes --text only",
                   "run wa send on the machine you read from; it reads the file there")
    if a.text_file is not None:
        try:
            with open(a.text_file, encoding="utf-8") as f:
                a.text = f.read()
        except (OSError, UnicodeDecodeError) as e:
            raise Fail(2, "cannot read --text-file: %s" % e)
        a.text_file = None
    text = (a.text or "").strip("\n")
    if not text.strip():
        raise Fail(2, "the message is empty", "pass --text '...' or --text-file FILE")
    return text


class AX:
    """The few Accessibility and CoreFoundation calls wa needs, through ctypes."""
    UTF8 = 0x08000100

    def __init__(self):
        import ctypes
        self.c = ctypes
        cf = ctypes.cdll.LoadLibrary(
            "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
        ax = ctypes.cdll.LoadLibrary(
            "/System/Library/Frameworks/ApplicationServices.framework/ApplicationServices")
        vp, i32, lng = ctypes.c_void_p, ctypes.c_int32, ctypes.c_long
        for fn, res, args in (
                (cf.CFStringCreateWithCString, vp, [vp, ctypes.c_char_p, ctypes.c_uint32]),
                (cf.CFStringGetLength, lng, [vp]),
                (cf.CFStringGetCString, ctypes.c_bool, [vp, ctypes.c_char_p, lng, ctypes.c_uint32]),
                (cf.CFGetTypeID, ctypes.c_ulong, [vp]),
                (cf.CFStringGetTypeID, ctypes.c_ulong, []),
                (cf.CFArrayGetTypeID, ctypes.c_ulong, []),
                (cf.CFArrayGetCount, lng, [vp]),
                (cf.CFArrayGetValueAtIndex, vp, [vp, lng]),
                (ax.AXIsProcessTrusted, ctypes.c_bool, []),
                (ax.AXUIElementCreateApplication, vp, [i32]),
                (ax.AXUIElementCopyAttributeValue, i32, [vp, vp, ctypes.POINTER(vp)]),
                (ax.AXUIElementPerformAction, i32, [vp, vp]),
                (ax.AXUIElementSetMessagingTimeout, i32, [vp, ctypes.c_float]),
                (ax.AXUIElementSetAttributeValue, i32, [vp, vp, vp]),
                (ax.CGEventCreateKeyboardEvent, vp, [vp, ctypes.c_uint16, ctypes.c_bool]),
                (ax.CGEventPostToPid, None, [i32, vp])):
            fn.restype, fn.argtypes = res, args
        self.cf, self.ax = cf, ax
        self.str_type, self.arr_type = cf.CFStringGetTypeID(), cf.CFArrayGetTypeID()
        self.names = {}

    def cfstr(self, s):
        if s not in self.names:  # kept for the life of the process
            self.names[s] = self.cf.CFStringCreateWithCString(None, s.encode(), self.UTF8)
        return self.names[s]

    def pystr(self, ref):
        size = self.cf.CFStringGetLength(ref) * 4 + 1
        buf = self.c.create_string_buffer(size)
        if not self.cf.CFStringGetCString(ref, buf, size, self.UTF8):
            return None
        return buf.value.decode("utf-8", "replace")

    def trusted(self):
        return bool(self.ax.AXIsProcessTrusted())

    def app(self, pid):
        el = self.ax.AXUIElementCreateApplication(pid)
        self.ax.AXUIElementSetMessagingTimeout(el, 2.0)
        return el

    def get(self, el, attr):
        """A string, a list of elements, another element, or None. Never frees: wa is short-lived."""
        out = self.c.c_void_p()
        if self.ax.AXUIElementCopyAttributeValue(el, self.cfstr(attr), self.c.byref(out)) != 0 \
                or not out.value:
            return None
        tid = self.cf.CFGetTypeID(out.value)
        if tid == self.str_type:
            return self.pystr(out.value)
        if tid == self.arr_type:
            return [self.cf.CFArrayGetValueAtIndex(out.value, i)
                    for i in range(self.cf.CFArrayGetCount(out.value))]
        return out.value

    def press(self, el):
        return self.ax.AXUIElementPerformAction(el, self.cfstr("AXPress")) == 0

    def focus(self, el):
        true = self.c.c_void_p.in_dll(self.cf, "kCFBooleanTrue")
        return self.ax.AXUIElementSetAttributeValue(el, self.cfstr("AXFocused"), true) == 0

    def return_key(self, pid):
        """Press Return in one app only. The key never reaches the app in front."""
        for down in (True, False):
            self.ax.CGEventPostToPid(pid, self.ax.CGEventCreateKeyboardEvent(None, 36, down))
            time.sleep(0.05)

    def walk(self, el, limit=6000):
        """Every element under el, breadth first, each with its parent chain."""
        queue, seen = [(el, ())], 0
        while queue and seen < limit:
            node, up = queue.pop(0)
            seen += 1
            yield node, up
            for child in self.get(node, "AXChildren") or []:
                queue.append((child, up + (node,)))

    def label(self, el):
        return " ".join(filter(None, (self.get(el, k) for k in (
            "AXDescription", "AXTitle", "AXIdentifier", "AXHelp"))))


def whatsapp_pid():
    p = subprocess.run(["/usr/bin/pgrep", "-x", "WhatsApp"], capture_output=True, text=True)
    pids = p.stdout.split()
    return int(pids[0]) if pids else None


def screen_locked():
    import plistlib
    try:
        out = subprocess.run(["/usr/sbin/ioreg", "-n", "Root", "-d1", "-a"],
                             capture_output=True, timeout=10).stdout
        users = plistlib.loads(out).get("IOConsoleUsers", [])
    except Exception:
        return False  # cannot tell; the composer check below still guards the send
    return any(u.get("CGSSessionScreenIsLocked") for u in users)


SEND_WORDS = re.compile(r"^send$|\bsend\b(?!.*\b(voice|audio|sticker|gif|photo|file)\b)", re.I)
REFUSED = re.compile(r"invalid|not on whatsapp|isn.t on whatsapp", re.I)


def ancestors(ax, el):
    up = []
    while len(up) < 15:
        el = ax.get(el, "AXParent")
        if not el or isinstance(el, (str, list)):
            break
        up.append(el)
    return up[::-1]  # root first, like walk()


def is_composer(ax, el, want):
    value = ax.get(el, "AXValue")
    return (isinstance(value, str) and norm(value) == want
            and ax.get(el, "AXRole") in ("AXTextArea", "AXTextField"))


def find_composer(ax, pid, text):
    """(composer, send button, buttons, refusal) in the chat whose composer holds text.

    The chat opened by the URL usually has the composer focused, so that is tried first.
    Otherwise every window is walked. buttons lists button labels for the failure message.
    It never collects message text, except a WhatsApp line that refuses the number.
    """
    want, app = norm(text), ax.app(pid)
    focused = ax.get(app, "AXFocusedUIElement")
    if focused and not isinstance(focused, (str, list)) and is_composer(ax, focused, want):
        return focused, nearest_send(ax, ancestors(ax, focused)), [], None
    buttons, refusal = [], None
    for win in ax.get(app, "AXWindows") or []:
        for el, up in ax.walk(win):
            role = ax.get(el, "AXRole")
            if role == "AXButton":
                buttons.append(clean(ax.label(el)) or "(no label)")
            elif role == "AXStaticText" and not refusal:
                line = ax.get(el, "AXValue") or ""
                refusal = line[:120] if isinstance(line, str) and REFUSED.search(line) else None
            elif is_composer(ax, el, want):
                return el, nearest_send(ax, up), buttons, None
    return None, None, buttons, refusal


def nearest_send(ax, up, seen=None):
    """The Send button closest to the composer: search its ancestors, nearest first.

    seen, when given, collects the labels of the buttons it passed, for --check.
    """
    for parent in reversed(up[-6:]):
        for el, _ in ax.walk(parent, limit=400):
            if ax.get(el, "AXRole") != "AXButton":
                continue
            label = ax.label(el)
            if seen is not None and clean(label) not in seen:
                seen.append(clean(label) or "(no label)")
            if SEND_WORDS.search(label):
                return el
    return None


def open_chat(target, text):
    """Open the chat with the text in its composer. Returns (ax, pid, composer, button).

    Raises Fail with nothing sent when Accessibility, the screen, the number or the window
    is not as expected.
    """
    if sys.platform != "darwin":
        raise Fail(3, "sending needs WhatsApp for Mac", "set WA_HOST to the Mac's SSH host")
    ax = AX()
    if not ax.trusted():
        raise Fail(3, "macOS has not given wa Accessibility, so it cannot press Send. "
                   "Nothing was sent.", AX_FIX)
    if screen_locked():
        raise Fail(3, "the Mac's screen is locked. Nothing was sent.", "unlock the Mac, then rerun")
    url = "whatsapp://send?" + urllib.parse.urlencode(
        {"phone": target["phone"].lstrip("+"), "text": text}, quote_via=urllib.parse.quote)
    if subprocess.run(["/usr/bin/open", "-g", url], capture_output=True).returncode != 0:
        raise Fail(3, "macOS could not open WhatsApp. Nothing was sent.",
                   "open WhatsApp for Mac and sign in, then rerun")
    deadline, buttons = time.time() + UI_WAIT, []
    while time.time() < deadline:
        time.sleep(0.5)
        pid = whatsapp_pid()
        if not pid:
            continue
        composer, button, buttons, refusal = find_composer(ax, pid, text)
        if composer and not button:
            raise Fail(1, "WhatsApp changed its window: no Send button next to the message. "
                       "Nothing was sent; the text is waiting in the chat.",
                       "press Send in WhatsApp yourself, or report it at " + ISSUES)
        if button:
            return ax, pid, composer, button
        if refusal:
            raise Fail(2, "WhatsApp cannot reach %s. It says: %s. Nothing was sent."
                       % (target["phone"], clean(refusal)), "check the number and its country code")
    raise Fail(1, "the chat did not open with the message in %ds. Nothing was sent. "
               "WhatsApp's buttons: %s" % (UI_WAIT, ", ".join(buttons[:40]) or "(no window)"),
               "open WhatsApp for Mac, check it is signed in, then rerun")


def press_send(target, text, after_pk):
    """Send the text in the open chat. Returns (how, row) once the composer let go of it.

    Tries the gentlest way first, and checks after each try that the message is not
    already in the database and the composer still holds the text, so it never sends
    twice. 1. Press Return in WhatsApp only. 2. Press the Send button. 3. Bring WhatsApp
    to the front, then press Return in WhatsApp only.
    """
    ax, pid, composer, button = open_chat(target, text)

    def settled():
        row = read_back(after_pk, target, text, wait=SETTLE_WAIT)
        if row:
            return row
        return None if find_composer(ax, pid, text)[0] else "composer empty"

    def via_return(front):
        if front:
            subprocess.run(["/usr/bin/open", "-b", "net.whatsapp.WhatsApp"], capture_output=True)
            time.sleep(0.7)
        found = find_composer(ax, pid, text)[0]
        if not found:
            return False
        ax.focus(found)
        time.sleep(0.2)
        ax.return_key(pid)
        return True

    # Return first: on WhatsApp 26.47 AXPress on the Send button returned ok and sent
    # nothing, while Return sent (2026-11-24).
    tries = (("the Return key", lambda: via_return(False)),
             ("the Send button", lambda: ax.press(button)),
             ("the Return key with WhatsApp in front", lambda: via_return(True)))
    for how, act in tries:
        if not act():
            continue
        got = settled()
        if got:
            return how, (got if isinstance(got, dict) else None)
    raise Fail(1, "WhatsApp did not send on the Send button or the Return key. Nothing was "
               "sent; the text is waiting in the chat.",
               "press Send in WhatsApp yourself, or report it at " + ISSUES)


def read_back(after_pk, target, text, wait=None):
    """The sent message's row once it is in the database, or None after READBACK_WAIT.

    It opens the database again on every try. A connection opened while WhatsApp was quit
    reads a frozen snapshot, and the URL may have just started WhatsApp.
    """
    want = norm(text)
    deadline = time.time() + (READBACK_WAIT if wait is None else wait)
    sql = ("SELECT m.Z_PK, m.ZMESSAGEDATE, s.ZCONTACTJID, s.ZPARTNERNAME, m.ZTEXT "
           "FROM ZWAMESSAGE m JOIN ZWACHATSESSION s ON s.Z_PK = m.ZCHATSESSION "
           "WHERE m.Z_PK > ? AND m.ZISFROMME = 1 ORDER BY m.Z_PK")
    while time.time() < deadline:
        db = connect(os.environ.get("WA_DB", DEFAULT_DB))
        rows = db.execute(sql, [after_pk]).fetchall()
        db.close()
        for pk, date, jid, name, body in rows:
            if norm(body) == want:
                return {"id": pk, "time": iso_time(date), "jid": jid,
                        "chat": clean(name or user_part(jid)),
                        "same_chat": jid == target["jid"] or (jid or "").endswith("@lid")}
        time.sleep(1)
    return None


def cmd_send(db, a):
    text = send_text(a)
    target = send_target(db, a.to)
    out = dict(target, text=text, chars=len(text), sent=False)
    if a.check:
        return check_chat(target, text, out)
    if not a.yes:
        return out, lambda o: "To:   %s (%s)\nText: %s" % (
            o["phone"], o["name"] or "new chat",
            "\n      ".join(clean(line) for line in o["text"].split("\n")))
    after = db.execute("SELECT coalesce(max(Z_PK), 0) FROM ZWAMESSAGE").fetchone()[0]
    how, got = press_send(target, text, after)
    got = got or read_back(after, target, text)
    if not got or not got["same_chat"]:
        where = "it is not in the database after %ds" % READBACK_WAIT if not got else \
            "it showed up in %s (%s), not %s" % (got["chat"], clean(got["jid"]), target["jid"])
        raise Fail(5, "WhatsApp took the message from the composer, but %s." % where,
                   "check the chat yourself: wa read %s -n 3" % shlex.quote(target["phone"]))
    out = dict(out, sent=True, confirmed=True, id=got["id"], time=got["time"],
               jid=got["jid"], name=got["chat"], via=how)
    return out, lambda o: "sent and confirmed: %s %s #%d" % (o["time"], o["phone"], o["id"])


def check_chat(target, text, out):
    """--check: open the chat with the text and find Send, but press nothing."""
    ax, pid, composer, button = open_chat(target, text)
    seen = []
    nearest_send(ax, ancestors(ax, composer), seen)
    out = dict(out, checked=True, composer=ax.get(composer, "AXRole"),
               send_button=clean(ax.label(button)), buttons=seen[:30])
    return out, lambda o: ("Ready: the message waits in the chat with %s. Nothing was sent.\n"
                           "Send button: %s\nButtons near it: %s" % (
                               o["phone"], o["send_button"], ", ".join(o["buttons"])))


def send_guard(a, as_json):
    """On the caller's machine, before wa send. Returns (stamp, argv to run on the Mac).

    It reads --text-file here, so a file on this machine works over SSH. With --yes it
    refuses a second send within SEND_GAP seconds, so wa never sends from a loop.
    """
    if a.check and a.yes:
        raise Fail(2, "--check and --yes do not go together", "pick one")
    forward = ["send", "--text=" + send_text(a)] + (["--yes"] if a.yes else []) \
        + (["--check"] if a.check else []) \
        + (["--json"] if as_json else []) + ["--", a.to]
    if not a.yes:
        return None, forward
    stamp = os.path.expanduser(SEND_STAMP)
    try:
        ago = time.time() - os.path.getmtime(stamp)
    except OSError:
        ago = None
    if ago is not None and 0 <= ago < SEND_GAP:
        raise Fail(2, "wa sent a message %ds ago. It sends one message at a time and never "
                   "from a loop." % ago, "wait %ds, then rerun" % (SEND_GAP - ago + 1))
    return stamp, forward


def mark_sent(stamp):
    if stamp:
        os.makedirs(os.path.dirname(stamp), exist_ok=True)
        with open(stamp, "w") as f:
            f.write(datetime.now().astimezone().isoformat(timespec="seconds") + "\n")


def hint(what, tries):
    print("%s Try: %s" % (what, tries), file=sys.stderr)


def emit(result, fmt, as_json):
    items = result if isinstance(result, list) else [result]
    if as_json:
        for item in items:
            item.pop("ts", None)  # internal sort key; JSON carries "time"/"last"
        print(json.dumps(result, ensure_ascii=False))
    else:
        for item in items:
            print(fmt(item))


CONTROL_PATH = os.path.expanduser("~/.ssh/wa-%C")


def remote_command(argv, host, timeout=30, launcher=None):
    """The ssh argv that runs wa on host: this script over stdin, or the installed launcher."""
    # One shared SSH connection, kept 10 minutes, turns a ~2 s call into a ~0.5 s one.
    # Keepalives drop it within ~10 s once the Mac sleeps, instead of hanging every call.
    return ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=%d" % min(timeout, 15),
            "-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=2",
            "-o", "ControlMaster=auto", "-o", "ControlPersist=10m",
            "-o", "ControlPath=" + CONTROL_PATH, "--", host,
            shlex.join([launcher] + argv) if launcher else
            "/usr/bin/env WA_LOCAL=1 WA_NOLOG=1 /usr/bin/python3 - " + shlex.join(argv)]


def run_remote(argv, host, timeout, capture=False):
    if LAUNCHER:
        src = b""  # the launcher runs its own installed copy of wa
    else:
        with open(os.path.realpath(__file__), "rb") as f:
            src = f.read()
    try:
        p = subprocess.run(remote_command(argv, host, timeout, LAUNCHER), input=src,
                           timeout=timeout, stdout=subprocess.PIPE if capture else None)
    except subprocess.TimeoutExpired:
        # A shared connection left from before the Mac slept can hang; close it so the
        # next call connects fresh.
        subprocess.run(["ssh", "-O", "exit", "-o", "ControlPath=" + CONTROL_PATH, "--", host],
                       capture_output=True, timeout=5)
        raise Fail(3, "no answer from %s after %ds" % (host, timeout),
                   "check the Mac is awake: ssh %s true" % shlex.quote(host))
    if p.returncode == 255:
        raise Fail(3, "cannot reach %s over SSH" % host,
                   "check the Mac is awake: ssh %s true" % shlex.quote(host))
    if p.returncode not in (0, 1, 2, 3, 4, 5):
        check = shlex.join([LAUNCHER, "--version"]) if LAUNCHER else "/usr/bin/python3 --version"
        raise Fail(3, "the command failed on %s (exit %d)" % (host, p.returncode),
                   "check it runs there: ssh %s %s" % (shlex.quote(host), check))
    return (p.returncode, p.stdout) if capture else p.returncode


def fetch_remote_media(a, host, timeout, as_json):
    code, out = run_remote(["media", str(a.id), "--b64", "--json"], host, timeout, capture=True)
    if code != 0:
        return code
    info = json.loads(out)
    data = base64.b64decode(info.pop("data"))

    def write(target):
        with open(target, "wb") as f:
            f.write(data)
    emit(save_media(info, write, a.o), lambda i: i["path"], as_json)
    return 0


def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="JSON output: bare array, or one object for status")
    common.add_argument("--timeout", type=int, default=argparse.SUPPRESS,
                        help="seconds to wait for WA_HOST over SSH (default 30)")
    msg = argparse.ArgumentParser(add_help=False)
    msg.add_argument("--all", action="store_true",
                     help="include group events and unlabeled message types")
    p = argparse.ArgumentParser(
        prog="wa", parents=[common], formatter_class=argparse.RawDescriptionHelpFormatter,
        description="WhatsApp CLI over the WhatsApp for Mac database. It reads, and sends one "
                    "message only with send --yes. Runs on the Mac, or over SSH when WA_HOST "
                    "is set. Times are the Mac's local time.",
        epilog="examples:\n  wa chats --unread\n  wa read 'Alice' -n 50\n"
               "  wa search invoice --since 30d\n  wa recent --since 6h --json\n"
               "  wa media 157535\n  wa status\n"
               "  wa send +6285283826458 --text-file msg.txt         # preview, sends nothing\n"
               "  wa send +6285283826458 --text-file msg.txt --yes   # send and confirm\n"
               "  WA_HOST=my-mac wa chats\n\n"
               "Status updates, broadcasts and hidden chats are skipped.\n" + ISSUES)
    p.add_argument("--version", action="version", version="wa " + VERSION)
    sub = p.add_subparsers(dest="cmd", metavar="command", required=True)
    c = sub.add_parser("chats", parents=[common], help="recent chats, newest first")
    c.add_argument("-n", type=positive_int, default=20, help="max chats (default 20)")
    c.add_argument("--unread", action="store_true", help="only chats with unread messages")
    r = sub.add_parser("read", parents=[common, msg], help="messages in one chat, oldest first")
    r.add_argument("chat", help="name substring, phone digits, or exact JID")
    r.add_argument("-n", type=positive_int, default=30, help="last N messages (default 30)")
    r.add_argument("--since", type=since_arg, help="30m, 24h, 7d, 2w or YYYY-MM-DD")
    s = sub.add_parser("search", parents=[common, msg], help="messages containing every word")
    s.add_argument("query", nargs="+", help="words that must all appear, any case")
    s.add_argument("--chat", help="limit to one chat")
    s.add_argument("--since", type=since_arg, help="30m, 24h, 7d, 2w or YYYY-MM-DD")
    s.add_argument("-n", type=positive_int, default=20, help="max results, newest first (default 20)")
    t = sub.add_parser("recent", parents=[common, msg], help="all chats since a time, oldest first")
    t.add_argument("--since", type=since_arg, default="24h", help="default 24h")
    t.add_argument("--chat", help="limit to one chat")
    t.add_argument("-n", type=positive_int, default=50, help="max messages (default 50)")
    m = sub.add_parser("media", parents=[common],
                       help="save one image, video, voice note or file, print its path")
    m.add_argument("id", type=positive_int, help="message id, from [image #id] or --json")
    m.add_argument("-o", metavar="PATH", help="folder or file to save to (default %s)"
                   % MEDIA_CACHE)
    m.add_argument("--b64", action="store_true", help=argparse.SUPPRESS)
    w = sub.add_parser("send", parents=[common],
                       help="send one message through WhatsApp for Mac; previews without --yes")
    w.add_argument("to", help="phone number with country code, or a direct chat's name or JID")
    body = w.add_mutually_exclusive_group(required=True)
    body.add_argument("--text", help="the message")
    body.add_argument("--text-file", metavar="FILE", help="read the message from a UTF-8 file")
    w.add_argument("--yes", action="store_true",
                   help="really send it, then confirm it in the database (exit 5 if not)")
    w.add_argument("--check", action="store_true",
                   help="open the chat with the text and find Send, but send nothing")
    sub.add_parser("status", parents=[common], help="check access and schema, print counts")
    sub.add_parser("usage", parents=[common], help="30-day stats from this machine's usage log")
    return p


def log_usage(cmd, code, ms, remote):
    if os.environ.get("WA_NOLOG"):
        return
    try:
        os.makedirs(os.path.dirname(USAGE_LOG), exist_ok=True)
        with open(USAGE_LOG, "a") as f:
            f.write(json.dumps({"ts": datetime.now().astimezone().isoformat(timespec="seconds"),
                                "cmd": cmd, "ok": code == 0, "exit": code, "ms": ms,
                                "remote": remote}) + "\n")
    except Exception:
        pass


def cmd_usage(as_json):
    cutoff = time.time() - 30 * 86400
    rows = []
    try:
        with open(USAGE_LOG) as f:
            for line in f:
                try:
                    e = json.loads(line)
                    if datetime.fromisoformat(e["ts"]).timestamp() >= cutoff:
                        rows.append(e)
                except (ValueError, KeyError):
                    continue
    except FileNotFoundError:
        pass
    by_cmd = {}
    for e in rows:
        by_cmd.setdefault(e["cmd"], []).append(e)
    out = {cmd: {"calls": len(es), "ok": sum(e["ok"] for e in es),
                 "avg_ms": int(sum(e["ms"] for e in es) / len(es)),
                 "exits": sorted({e["exit"] for e in es})} for cmd, es in by_cmd.items()}
    if not rows:
        hint("No calls logged in 30 days at %s." % USAGE_LOG, "wa status")
    print(json.dumps(out, ensure_ascii=False) if as_json else "\n".join(
        "%s: %d calls, %d ok, avg %d ms, exits %s" % (k, v["calls"], v["ok"], v["avg_ms"], v["exits"])
        for k, v in sorted(out.items())))


COMMANDS = {"chats": cmd_chats, "read": cmd_read, "search": cmd_search,
            "recent": cmd_recent, "media": cmd_media, "status": cmd_status, "send": cmd_send}


def main(argv):
    a = build_parser().parse_args(argv)
    as_json, timeout = getattr(a, "json", False), getattr(a, "timeout", 30)
    if LAUNCHED and (a.cmd == "usage" or (a.cmd == "media" and not a.b64)):
        # The granted process must never write a file: a symlink could aim the write
        # into a folder macOS protects. Media goes back as data and is saved by the caller.
        print("wa: under wa-launch, wa only reads, so media comes back as data (--b64)",
              file=sys.stderr)
        print("Try: run wa media on the machine you read from; it saves the file there",
              file=sys.stderr)
        return 2
    if a.cmd == "usage":
        cmd_usage(as_json)
        return 0
    path = os.environ.get("WA_DB", DEFAULT_DB)
    # On a Mac without WA_HOST, read locally even when macOS hides the file, so the
    # Full Disk Access error names the fix. Off a Mac, WA_HOST is the only way in.
    local = (os.environ.get("WA_LOCAL") == "1" or "WA_DB" in os.environ
             or os.path.exists(path) or (not HOST and sys.platform == "darwin"))
    start, stamp = time.time(), None
    try:
        if a.cmd == "send" and not os.environ.get("WA_LOCAL"):
            stamp, forward = send_guard(a, as_json)  # the machine you typed wa send on
        if local:
            db = connect(path)
            try:
                result, fmt = COMMANDS[a.cmd](db, a)
            except sqlite3.Error as e:
                raise Fail(3, "query failed: %s" % e, "wa status, then report it at " + ISSUES)
            emit(result, fmt, as_json)
            code = 0
        elif HOST and a.cmd == "media":
            code = fetch_remote_media(a, HOST, timeout, as_json)
        elif HOST and a.cmd == "send":
            code = run_remote(forward, HOST, max(timeout, UI_WAIT + READBACK_WAIT + 30))
        elif HOST:
            code = run_remote(argv, HOST, timeout)
        else:
            raise Fail(3, "no WhatsApp for Mac database on this machine",
                       "run wa on the Mac, or set WA_HOST to the Mac's SSH host")
    except Fail as f:
        print("wa: " + f.msg, file=sys.stderr)
        if f.hint:
            print("Try: " + f.hint, file=sys.stderr)
        code = f.code
    except BrokenPipeError:
        raise
    except Exception as e:  # a bug in wa, never the schema-drift exit code
        print("wa: unexpected %s: %s" % (type(e).__name__, e), file=sys.stderr)
        print("Try: report it at " + ISSUES, file=sys.stderr)
        code = 4
    if a.cmd == "send" and not os.environ.get("WA_LOCAL"):
        if code in (0, 5) and stamp:
            mark_sent(stamp)  # 5 may have sent, so it counts toward the gap too
        elif code == 0 and not a.check:
            sys.stdout.flush()
            print("Not sent. To send it: " + shlex.join(["wa"] + argv + ["--yes"]), file=sys.stderr)
    log_usage(a.cmd, code, int((time.time() - start) * 1000), not local)
    return code


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        # The reader closed early (| head). Silence the flush at exit too.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
